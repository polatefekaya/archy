{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "archy agent-hook session-start",
            "timeout": 15,
            "statusMessage": "Loading Archy architecture context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "archy agent-hook post-tool-use",
            "timeout": 30,
            "statusMessage": "Reviewing Archy architecture impact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "archy agent-hook stop",
            "timeout": 15,
            "statusMessage": "Finalizing Archy session"
          }
        ]
      }
    ]
  }
}
